# Salin ke .env.local lalu isi. PRD §2.3.

# Database (Turso)
TURSO_DATABASE_URL=libsql://<nama-db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Notifikasi lead (Telegram)
# Chat ID grup: kirim "/start@nama_bot" di grup, lalu buka
# https://api.telegram.org/bot<TOKEN>/getUpdates dan ambil "chat":{"id": ...}.
# ID grup bernilai negatif, mis. -1001234567890 (sertakan tanda minus).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Garam rahasia hash IP. Buat dengan (PowerShell/terminal mana pun):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=abeccadb57917bd145a0f51558daaba40f60662740be6e025b62361308eb76f7

# Format internasional tanpa "+", mis. 6281234567890
NEXT_PUBLIC_WA_NUMBER=6285846153092
# Production: https://kemalofcs.my.id (isi di Environment Variables Vercel). Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://kemalofcs.my.id
